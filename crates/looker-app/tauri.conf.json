{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Looker",
  "version": "0.1.0",
  "identifier": "com.looker.app",
  "build": {
    "frontendDist": "../looker-gateway/ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LOOKER // Network Control & Proxy Gateway",
        "url": "http://127.0.0.1:8080/ui",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
